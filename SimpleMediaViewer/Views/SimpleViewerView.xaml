<Window x:Class="SimpleMediaViewer.Views.SimpleViewerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleMediaViewer.Views"
        xmlns:vm="clr-namespace:SimpleMediaViewer.ViewModels"
        d:DataContext="{d:DesignInstance vm:SimpleViewerViewModel}"
        xmlns:bhvs="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="SimpleViewerView" Height="450" Width="800">
    <Window.DataContext>
        <vm:SimpleViewerViewModel />
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Label Margin="10" FontSize="20" FontWeight="Bold" Content="Media List"/>
            <ListBox ItemsSource="{Binding MediaInfos}" SelectedItem="{Binding SelectedMediaInfo}" 
                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                     Width="Auto" Height="Auto" DisplayMemberPath="MediaName">
            </ListBox>
        </StackPanel>
        
        <Border BorderBrush="Black" BorderThickness="2" Grid.Row="0" Grid.Column="1" Margin="10">
            <MediaElement Name="mediaElement" 
                          Source="{Binding MediaPath}" 
                          LoadedBehavior="Manual" 
                          UnloadedBehavior="Stop" 
                          Stretch="Uniform"/>
        </Border>
        <Slider Grid.Row="1" Grid.Column="1" Margin="10" Value="{Binding ElementName=mediaElement, Path=Position}" 
                Minimum="0" Maximum="{Binding ElementName=mediaElement, Path=NaturalDuration.TimeSpan.TotalSeconds}"
                Height="30" VerticalAlignment="Top" />
        
        <StackPanel Grid.Row="0" Grid.Column="2" Margin="10" Grid.ColumnSpan="2">
            <Button Content="Play" Width="60" Height="50" Margin="10">
                <bhvs:Interaction.Triggers>
                    <bhvs:EventTrigger EventName="Click">
                        <bhvs:CallMethodAction TargetObject="{Binding}" MethodName="PlayMediaButton_Click"/>
                    </bhvs:EventTrigger>
                </bhvs:Interaction.Triggers>
            </Button>
            <Button Content="Pause" Width="60" Height="50" Margin="10">
                <bhvs:Interaction.Triggers>
                    <bhvs:EventTrigger EventName="Click">
                        <bhvs:CallMethodAction TargetObject="{Binding}" MethodName="PauseMediaButton_Click"/>
                    </bhvs:EventTrigger>
                </bhvs:Interaction.Triggers>
            </Button>
            <Button Content="Stop" Width="60" Height="50" Margin="10">
                <bhvs:Interaction.Triggers>
                    <bhvs:EventTrigger EventName="Click">
                        <bhvs:CallMethodAction TargetObject="{Binding}" MethodName="StopMediaButton_Click"/>
                    </bhvs:EventTrigger>
                </bhvs:Interaction.Triggers>
            </Button>
        </StackPanel>
    </Grid>
</Window>
