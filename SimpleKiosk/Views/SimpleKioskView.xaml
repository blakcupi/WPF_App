<Window x:Class="SimpleKiosk.Views.SimpleKioskView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SimpleKiosk.ViewModels"
        xmlns:local="clr-namespace:SimpleKiosk.Views"
        xmlns:bhvs="http://schemas.microsoft.com/xaml/behaviors"
        d:DataContext="{d:DesignInstance vm:SimpleKioskViewModel}"
        mc:Ignorable="d"
        Title="SimpleKioskView" Height="250" Width="500">
    <Window.DataContext>
        <vm:SimpleKioskViewModel />
    </Window.DataContext>
    
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Label Content="Burger :" Margin="5" Width="100" Height="30" VerticalContentAlignment="Center"/>
                <ComboBox Margin="5" Width="200" Height="30"
                          ItemsSource="{Binding Burgers}" SelectedItem="{Binding SelectedBurgerType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Label Content="Coffee :" Margin="5" Width="100" Height="30" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding Coffees}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                        
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="5" Height="30" VerticalContentAlignment="Center" 
                                      Content="{Binding Name}" 
                                      FontSize="20" 
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Label Content="Total Price :" Margin="5" Width="100" Height="30" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txtTotalAmount" 
                         Margin="5" Width="200" Height="50" Background="Gold" 
                         FontSize="30" FontWeight="Bold" Foreground="DarkRed"
                         Text="{Binding TotalAmount}" IsReadOnly="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
