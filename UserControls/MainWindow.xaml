<Window x:Class="UserControls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UserControls"
        xmlns:vm="clr-namespace:UserControls.ViewModels"
        xmlns:uc="clr-namespace:UserControls.Controls"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        mc:Ignorable="d"
        
        Title="UserControls Test" Height="450" Width="600">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFABADB3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
    </Window.Resources>
    
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
    
        <TabControl Grid.Row="0" Margin="5">
            <TabItem TabIndex="0" Header="Search" Width="100">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <uc:UCSearchBox Grid.Row="0" Grid.Column="0" Margin="5"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                        SearchCommand="{Binding SearchCommand}"
                        Watermark="Searching..." />
                    
                    <Border Grid.Row="1" Grid.Column="0" Margin="5">
                        <TextBox Margin="5" BorderThickness="0" Text="{Binding TextData, Mode=OneWay}" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem TabIndex="1" Header="Busy Indicator" Width="100">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <DockPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock DockPanel.Dock="Left" Margin="5" Text="Uri :" VerticalAlignment="Center" FontWeight="Bold" />
                        <Grid DockPanel.Dock="Right" >
                            <Button Margin="5" Padding="3" Content="Crawling" 
                                Width="60" Height="30" FontSize="9" BorderBrush="LightGray" BorderThickness="1"
                                Command="{Binding CrawlingCommand}" CommandParameter="{Binding UriText}"/>                            
                        </Grid>
                        <Border Margin="5" DockPanel.Dock="Right">
                            <TextBox Margin="0 5 5 5" MinWidth="200" BorderThickness="0" 
                                     Text="{Binding UriText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>                        
                    </DockPanel>
                    
                    <Border Grid.Row="1" Grid.Column="0" Margin="5">
                            <TextBox Margin="2" 
                                 TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                 Text="{Binding CrawlResult, Mode=OneWay}" />
                    </Border>
                    <uc:UCBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy}" Message="불러오는 중..." />
                </Grid>
            </TabItem>
            
            <TabItem TabIndex="2" Header="ToggleSwitch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Button Margin="5" Width="30" Height="30" Background="Red" Command="{Binding BackgroundCommand}" CommandParameter="Red" />
                        <Button Margin="5" Width="30" Height="30" Background="Green" Command="{Binding BackgroundCommand}" CommandParameter="Green" />
                        <Button Margin="5" Width="30" Height="30" Background="Blue" Command="{Binding BackgroundCommand}" CommandParameter="Blue" />
                        <uc:UCToggleSwitch Margin="30 0" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                           OnContent="배경색 적용" OffContent="배경색 제거" />
                    </StackPanel>

                    <Border Margin="5" Grid.Row="1">
                        <StackPanel Background="{Binding BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem TabIndex="3" Header="NumericUpDown">
                <Grid>
                    <uc:UCNumericBox Margin="5" Value="{Binding ValueText}"
                                     MinValue="0" MaxValue="100" StepValue="5" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Margin="5" >
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="5" Text="Status: " VerticalAlignment="Center" FontWeight="Bold" />
                <TextBlock Margin="0 5" 
                                       VerticalAlignment="Center"
                                       FontSize="15" FontWeight="Bold" Foreground="DarkRed"
                                       Text="{Binding StatusText}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
