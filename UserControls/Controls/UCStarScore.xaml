<UserControl x:Class="UserControls.Controls.UCStarScore"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ucStarScore">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="StarButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Padding" Value="1 0" />
                <Setter Property="Foreground" Value="AntiqueWhite" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFilled}" Value="True">
                        <Setter Property="Foreground" Value="Gold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Stars, ElementName=ucStarScore}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Style="{StaticResource StarButtonStyle}"
                        Content="&#x2605;"
                        Command="{Binding StarChoiceCommand, ElementName=ucStarScore}"
                        CommandParameter="{Binding Index}" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
