<UserControl x:Class="UserControls.Controls.UCBusyIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ucBusyIndicator">
    <!-- 사용법: 다른 콘텐츠와 같은 Grid 셀에 마지막으로 배치하면 위를 덮는 오버레이가 된다. -->
    <Border Background="Transparent">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy, ElementName=ucBusyIndicator}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="40" Height="40"
                     StrokeThickness="10"
                     StrokeDashArray="15 150"
                     StrokeDashCap="Round"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#002D7DD2" Offset="0" />
                        <GradientStop Color="#FF0E1D5A" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
                
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotation" Angle="0" />
                </Ellipse.RenderTransform>

                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Style.Triggers>
                                 <DataTrigger Binding="{Binding IsBusy, ElementName=ucBusyIndicator}" Value="True">
                                <!-- 시작: 무한 회전 -->
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                    From="0" To="360" Duration="0:0:2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>

                                <!-- 종료: 같은 속성을 0도로 덮어써서 회전 중지 -->
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                    To="0" Duration="0:0:0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
                <!--<Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>-->
            </Ellipse>

            <TextBlock Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       Foreground="#FF333333"
                       Text="{Binding Message, ElementName=ucBusyIndicator}" />
        </StackPanel>
    </Border>
</UserControl>
