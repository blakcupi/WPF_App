<UserControl x:Class="UserControls.Controls.UCToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ToggleSwitch">
    <StackPanel Orientation="Horizontal">
        <ToggleButton IsChecked="{Binding IsChecked, ElementName=ToggleSwitch, Mode=TwoWay}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" Width="40" Height="20"
                            Background="LightGray" BorderBrush="DarkGray" BorderThickness="2" 
                            CornerRadius="9">
                        <Ellipse Name="Thumb" Width="15" Height="15" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Track" Property="Background" Value="LightBlue"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="DarkBlue"/>   
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="LightSteelBlue"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="Track" Property="Background" Value="LightGray"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="Gray"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{Binding OffContent, ElementName=ToggleSwitch}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=ToggleSwitch}" Value="True">
                            <Setter Property="Text" Value="{Binding OnContent, ElementName=ToggleSwitch}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
