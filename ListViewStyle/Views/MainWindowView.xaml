<Window x:Class="ListViewStyle.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ListViewStyle.Views"
        xmlns:vm="clr-namespace:ListViewStyle.ViewModels"
        d:DataContext="{d:DesignInstance vm:PersonViewModel}"
        mc:Ignorable="d"
        Title="MainWindowView" Height="500" Width="1200">
    <Window.DataContext>
        <vm:PersonViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- 활성 항목용 템플릿 -->
        <DataTemplate x:Key="ActiveTpl">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="● " Foreground="Green"/>
                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                <TextBlock Text="{Binding Age, StringFormat={}{0}세}" Width="50" />
                <CheckBox IsChecked="{Binding IsActive}" />
            </StackPanel>
        </DataTemplate>

        <!-- 비활성 항목용 템플릿 -->
        <DataTemplate x:Key="InactiveTpl">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="○ " Foreground="Gray"/>
                <TextBlock Text="{Binding Name}" Foreground="Gray"/>
                <TextBlock Text="{Binding Age, StringFormat={}{0}세}" Width="50" />
                <CheckBox IsChecked="{Binding IsActive}" />
            </StackPanel>
        </DataTemplate>

        <!-- 셀렉터도 리소스로 두면 재사용하기 좋습니다 -->
        <local:PersonTemplateSelector x:Key="PersonSelector"
                                  ActiveTemplate="{StaticResource ActiveTpl}"
                                  InactiveTemplate="{StaticResource InactiveTpl}"/>
    </Window.Resources>


    <Grid>
        <UniformGrid Columns="4">
            <StackPanel  Margin="5" Height="Auto">
                <Label Content="DisplayMemberPath" />
                <ListView Width="250" Height="Auto" Margin="10" Background="Beige" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}"
                      DisplayMemberPath="Name">
                </ListView>
            </StackPanel>

            <StackPanel  Margin="5" Height="Auto">
                <Label Content="ListView.ItemTemplate -> DataTemplate" />
                <ListView Width="250" Margin="10" Background="SkyBlue" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="x:Type local:PersonModel">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding Name}" Width="100" FontWeight="Bold" />
                                <TextBlock Text="{Binding Age, StringFormat={}{0}세}" Width="50" />
                                <CheckBox IsChecked="{Binding IsActive}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Margin="5">
                <Label Content="ListView.ItemsPanel" />
                <ListView Width="250" Margin="10" Background="YellowGreen" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="x:Type local:PersonModel">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding Name}" Width="100" FontWeight="Bold" />
                                <TextBlock Text="{Binding Age, StringFormat={}{0}세}" Width="50" />
                                <CheckBox IsChecked="{Binding IsActive}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Margin="5">
                <Label Content="ListView.ItemContainerStyle" />
                <ListView Width="250" Margin="10" Background="Beige" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                    <Setter Property="Foreground" Value="Gray" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="LightSkyBlue" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="x:Type local:PersonModel">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding Name}" Width="100" FontWeight="Bold" />
                                <TextBlock Text="{Binding Age, StringFormat={}{0}세}" Width="50" />
                                <CheckBox IsChecked="{Binding IsActive}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Margin="5">
                <Label Content="ListView.ItemTemplateSelector" />
                <ListView Width="250" Margin="10" Background="SkyBlue"
                          ItemsSource="{Binding People}" 
                          SelectedItem="{Binding SelectedPerson}"
                          ItemTemplateSelector="{StaticResource PersonSelector}"/>
            </StackPanel>

            <StackPanel Margin="5">
                <Label Content="ListView + GridView" />
                <ListView Width="250" Margin="10" Background="YellowGreen" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}"
                          SizeChanged="ListView_SizeChanged">
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Padding" Value="5" />
                                    <Setter Property="Background" Value="Gold" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>

                            <GridViewColumn Header="ID" Width="50" DisplayMemberBinding="{Binding Id}" />
                            <GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Age" Width="50" DisplayMemberBinding="{Binding Age}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>

            <StackPanel Margin="5">
                <Label Content="GridView - CellTemplate, HeaderTemplate" />
                <ListView Width="250" Margin="10" Background="YellowGreen" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}"
                          SizeChanged="ListView_SizeChanged">
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Padding" Value="5" />
                                    <Setter Property="Background" Value="Gold" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>

                            <GridViewColumn Header="활성" Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsActive}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="ID" Width="40" DisplayMemberBinding="{Binding Id}" />
                            <GridViewColumn Header="Name" Width="90" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Age" Width="40" DisplayMemberBinding="{Binding Age}" />
                            <GridViewColumn Header="삭제" Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="삭제" 
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </UniformGrid>
    </Grid>
</Window>
