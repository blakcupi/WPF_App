<Window x:Class="SimpleBinding.Views.SimpleBindingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleBinding.Views"
        xmlns:vm="clr-namespace:SimpleBinding.ViewModels"
        d:DataContext="{d:DesignInstance vm:SimpleBindingViewModel}"
        xmlns:bhvs="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="SimpleBindingView" Height="250" Width="600">
    <Window.DataContext>
        <vm:SimpleBindingViewModel />
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        
        <UniformGrid Grid.Row="0" Grid.Column="0" Columns="5" Margin="10" HorizontalAlignment="Center">
            <ComboBox Margin="10" ItemsSource="{Binding CalcTypes}" SelectedItem="{Binding SelectedCalcType}" 
                      Width="90" Height="30" FontSize="14" FontWeight="Bold"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            <TextBox Margin="10" Text="{Binding KoreanText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="70" Height="30" FontSize="20" FontWeight="Bold" 
                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            <TextBox Margin="10" Text="{Binding MathmeticsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="70" Height="30" FontSize="20" FontWeight="Bold" 
                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            <TextBox Margin="10" Text="{Binding EnglishText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="70" Height="30" FontSize="20" FontWeight="Bold" 
                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            <Button Content="Calculate" Margin="10" Width="80" Height="30">
                <bhvs:Interaction.Triggers>
                    <bhvs:EventTrigger EventName="Click">
                        <bhvs:CallMethodAction TargetObject="{Binding}" MethodName="CalculationButton_Click" />
                    </bhvs:EventTrigger>
                </bhvs:Interaction.Triggers>
            </Button>
        </UniformGrid>
        
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBox Margin="10" Text="{Binding Score, Mode=OneWay}" FontSize="30" FontWeight="Bold" Foreground="DarkRed"
                       Width="200" Height="50" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True"/>
            <CheckBox Margin="5" Content="Round Off" IsChecked="{Binding IsRoundOff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
