<Window x:Class="RandomGen.Views.RandomGenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RandomGen.Views"
        xmlns:vm="clr-namespace:RandomGen.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:RandomGenViewModel}"
        xmlns:bhvs="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="RandomGenView" Height="400" Width="400">
    <Window.DataContext>
        <vm:RandomGenViewModel />
    </Window.DataContext>
        
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        
        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"
               Content="Random Number Generator with Two Digits" />
        
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.RowSpan="2"
                    Margin="10" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Label Margin="0, 10, 0, 0" Content="Start Number" HorizontalContentAlignment="Center" />
            <TextBox Text="{Binding StartNumber, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="50"/>
            <Label Margin="0, 10, 0, 0" Content="End Number" HorizontalContentAlignment="Center" />
            <TextBox Text="{Binding EndNumber, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="50"/>            
        </StackPanel>

        <Border BorderThickness="1" BorderBrush="Black" Grid.Row="1" Grid.Column="1" Margin="10">
            <StackPanel Orientation="Horizontal" Width="Auto" Height="Auto" Margin="10" HorizontalAlignment="Center">
                <!--<TextBox Text="{Binding FirstImage, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="50"/>
                <TextBox Text="{Binding SecondImage, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="50"/>-->
                <Image Source="{Binding FirstImage}" Margin="5 5" Width="100" Height="Auto"/>
                <Image Source="{Binding SecondImage}" Margin="5 5" Width="100" Height="Auto"/>
            </StackPanel>
        </Border>
        
        <Button Grid.Row="2" Grid.Column="1" Content="Generate" Width="100" Height="50">
            <bhvs:Interaction.Triggers>
                <bhvs:EventTrigger EventName="Click">
                    <bhvs:CallMethodAction MethodName="GenerateButton_Click" TargetObject="{Binding}" />
                </bhvs:EventTrigger>
            </bhvs:Interaction.Triggers>
        </Button>
    </Grid>
</Window>
